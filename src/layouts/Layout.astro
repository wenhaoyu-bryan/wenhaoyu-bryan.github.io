---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { isMirroredRoute, normalizeRoutePath } from "@/i18n/routes";
import config from "@/config";
import BackToTop from "@/components/BackToTop.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  ogImageAlt?: string;
  canonicalURL?: string;
  noindex?: boolean;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  ogType = "website",
  ogImageAlt = title,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const rssURL = new URL("/rss.xml", Astro.site ?? Astro.url);
const currentLocale = Astro.currentLocale ?? config.site.lang;

// Person schema: establishes the author entity for search engines and AI search
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site.url}#person`,
  name: site.author,
  url: site.url,
  jobTitle: "AI Product Manager",
  description:
    "AI Product Manager building agentic workflows, ontology-driven systems, and AI-native product tools.",
  knowsAbout: [
    "Agentic Workflows",
    "Ontology-Driven AI Products",
    "AI-Assisted Delivery",
    "Harness Engineering",
    "Loop Engineering",
    "Vibe Coding",
    "Industrial & B2B AI",
  ],
  sameAs: config.socials
    .map(s => s.url)
    .filter(url => !url.startsWith("mailto:")),
});

const normalizedPath = normalizeRoutePath(Astro.url.pathname);
const basePath = normalizedPath.startsWith("/zh/")
  ? normalizeRoutePath(normalizedPath.slice(3))
  : normalizedPath;

// Person identifies the author on identity pages; WebSite describes the site
// itself on the home page. Blog posts carry their own BlogPosting schema
// (see PostLayout), so Person is intentionally not repeated there.
const isHome = basePath === "/";
const isAbout = basePath === "/about/";

const webSiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}#website`,
  name: site.title,
  url: site.url,
  description: site.description,
  inLanguage: Astro.currentLocale ?? site.lang,
  author: {
    "@type": "Person",
    "@id": `${site.url}#person`,
    name: site.author,
    url: site.profile ?? site.url,
  },
});

const webPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: title,
  description,
  inLanguage: currentLocale,
  isPartOf: { "@id": `${site.url}#website` },
});

const hreflangAlternates = isMirroredRoute(basePath)
  ? [
      { lang: "en", href: new URL(basePath, Astro.site).href },
      { lang: "zh", href: new URL(`/zh${basePath}`, Astro.site).href },
      { lang: "x-default", href: new URL(basePath, Astro.site).href },
    ]
  : [];
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="apple-touch-icon" href={getAssetPath("apple-touch-icon.png")} />
    <link rel="manifest" href={getAssetPath("site.webmanifest")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta
      property="og:locale"
      content={currentLocale === "zh" ? "zh_CN" : "en_US"}
    />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} — Posts`}
      href={rssURL}
    />

    <!-- Language alternates for bilingual pages -->
    {
      hreflangAlternates.map(alt => (
        <link rel="alternate" hreflang={alt.lang} href={alt.href} />
      ))
    }

    <!-- Structured data: a page entity for every page, plus site identity data -->
    <script is:inline type="application/ld+json" set:html={webPageJsonLd} />
    {
      (isHome || isAbout) && (
        <script is:inline type="application/ld+json" set:html={personJsonLd} />
      )
    }
    {
      isHome && (
        <script is:inline type="application/ld+json" set:html={webSiteJsonLd} />
      )
    }

    <!-- Privacy-friendly analytics (only when a GoatCounter code is configured) -->
    {
      site.goatCounterCode && (
        <script
          is:inline
          data-goatcounter={`https://${site.goatCounterCode}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }

    <!-- Static defaults so browser chrome matches the background on first paint
         (before JS runs), keyed to the OS scheme. theme.ts then fills the
         id="theme-color" tag with the actually-selected background so a manual
         toggle that disagrees with the OS preference still matches. An empty
         content value is ignored by browsers, so the media tags win pre-JS. -->
    <meta
      name="theme-color"
      content="#fdfdfd"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#212737"
      media="(prefers-color-scheme: dark)"
    />
    <meta id="theme-color" name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        document.firstElementChild?.setAttribute("data-theme", theme);
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <slot />
    <BackToTop />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
