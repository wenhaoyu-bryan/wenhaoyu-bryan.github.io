---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Update the date whenever this page's content changes.
const lastUpdated = "November 19, 2026";

const building = [
  "Leading product design for an enterprise agent platform delivered to customers within the group; preparing for external customers and adapting it for China's domestic IT ecosystem.",
  "Exploring ontology and knowledge workflows through reviewable prototypes and collaboration with colleagues.",
  "Maintaining this bilingual portfolio and publishing notes on AI product work.",
];

const exploring = [
  "How ontology and knowledge graphs make enterprise AI more reliable and operational.",
  "How multi-agent sessions and orchestrator–worker designs can support coordination and governance.",
  "How PMs can use vibe coding to validate ideas faster and hand engineering a working blueprint.",
  "How AI search (GEO) changes the way products get discovered and adopted.",
  "How coding agents can help make product handoffs and implementation reviews more explicit.",
];

const shipped = [
  "Chinese translations for all six published blog articles, with links between their English and Chinese versions.",
  "Article contents and estimated reading times for longer posts and playbook pages.",
  "Agent Anatomy, an interactive visual series about how AI agents work.",
  "An updated enterprise agent platform case study that distinguishes internal customer delivery from ongoing work.",
];
---

<Layout
  title={`Now — ${config.site.title}`}
  description="What Wenhao Yu is focused on right now — current projects, what he's exploring, and recently shipped work. A now page in the nownownow.com tradition."
  ogImage="/og/now.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Now" class="app-prose">
    <p class="text-muted-foreground text-sm">
      What I'm focused on right now. This is a
      <a href="https://nownownow.com/about" class="text-accent hover:underline"
        >now page</a
      > — a snapshot, not a changelog. Last updated {lastUpdated}.
    </p>

    <h2 class="mt-8 text-xl font-semibold">Building</h2>
    <ul class="mt-2 space-y-2">
      {building.map(item => <li>{item}</li>)}
    </ul>

    <h2 class="mt-8 text-xl font-semibold">Exploring</h2>
    <ul class="mt-2 space-y-2">
      {exploring.map(item => <li>{item}</li>)}
    </ul>

    <h2 class="mt-8 text-xl font-semibold">Recently Shipped</h2>
    <ul class="mt-2 space-y-2">
      {shipped.map(item => <li>{item}</li>)}
    </ul>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">Elsewhere</h2>
      <div class="mt-3 flex flex-wrap gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "ai-stack")}
          class="text-accent hover:underline"
        >
          My AI Stack
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="text-accent hover:underline"
        >
          Projects
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-accent hover:underline"
        >
          About
        </a>
      </div>
    </div>
  </Main>

  <Footer />
</Layout>
