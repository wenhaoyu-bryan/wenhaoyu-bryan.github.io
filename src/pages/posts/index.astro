---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Posts (essays), newest first — the shelf lists them all.
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);

// The live Methodology pages (mirrors playbook.astro).
const playbookItems = [
  {
    label: "Vibe Coding for Product Discovery",
    href: getRelativeLocaleUrl(locale, "playbook/vibe-coding"),
  },
  {
    label: "Harness Engineering",
    href: getRelativeLocaleUrl(locale, "playbook/harness-engineering"),
  },
  {
    label: "Loop Engineering",
    href: getRelativeLocaleUrl(locale, "playbook/loop-engineering"),
  },
  {
    label: "AI-Native PRD",
    href: getRelativeLocaleUrl(locale, "playbook/ai-native-prd"),
  },
  {
    label: "PRD to Prototype Workflow",
    href: getRelativeLocaleUrl(locale, "playbook/prd-to-prototype"),
  },
  {
    label: "Agent Product Design Framework",
    href: getRelativeLocaleUrl(locale, "playbook/agent-product-design"),
  },
  {
    label: "Prompt-to-Ontology",
    href: getRelativeLocaleUrl(locale, "playbook/prompt-to-ontology"),
  },
];

// Growth Lab status chip — derived from the experiment list so the count stays
// in sync (mirrors the experiments in growth-lab.astro: 00 concluded, 01 running).
const growthExperiments = [{ status: "Concluded" }, { status: "Running" }];
const runningCount = growthExperiments.filter(
  e => e.status === "Running"
).length;
const growthChip = `${growthExperiments.length} experiments · ${runningCount} running`;
---

<Layout
  title={`Thinking — ${config.site.title}`}
  description="Where I think in public: an evergreen AI PM methodology playbook, a growth-experiment notebook, and essays on agents, ontology, and shipping with coding agents."
  ogImage="/og/thinking.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Thinking" class="max-w-3xl">
    <p class="text-muted-foreground -mt-4 mb-8">
      Where I think in public — an evergreen methodology playbook, a
      growth-experiment notebook, and essays and working notes.
    </p>

    <!-- Methodology -->
    <section>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">Methodology</h2>
        <a
          href={getRelativeLocaleUrl(locale, "playbook")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          All methodologies →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        Evergreen methodology: how I run AI-assisted product work.
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          playbookItems.map(item => (
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 text-xs">&#x2022;</span>
              <a href={item.href} class="text-accent text-sm hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Growth Lab -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">Growth Lab</h2>
        <a
          href={getRelativeLocaleUrl(locale, "growth-lab")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          Open the notebook →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        A public experiment notebook — hypothesis to measurement.
      </p>
      <a
        href={getRelativeLocaleUrl(locale, "growth-lab")}
        class="border-border group hover:bg-accent/5 mt-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-lg border p-4 transition-colors"
      >
        <span class="group-hover:text-accent font-medium transition-colors">
          SEO &amp; GEO experiments, run in the open
        </span>
        <span
          class="border-border text-muted-foreground shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap"
        >
          {growthChip}
        </span>
      </a>
    </section>

    <!-- Posts -->
    <section class="mt-10">
      <h2 class="text-xl font-semibold">Posts</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        Essays and working notes on AI product management.
      </p>
      <ul class="mt-4 space-y-2">
        {
          posts.map(post => (
            <li class="flex items-baseline justify-between gap-3">
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class="text-accent text-sm hover:underline"
              >
                {post.data.title}
              </a>
              <Datetime
                pubDatetime={post.data.pubDatetime}
                modDatetime={post.data.modDatetime}
                size="sm"
                class="text-muted-foreground shrink-0 text-xs"
              />
            </li>
          ))
        }
      </ul>
    </section>
  </Main>

  <Footer />
</Layout>
