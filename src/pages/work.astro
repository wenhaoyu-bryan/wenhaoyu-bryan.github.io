---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getWork } from "@/data/projects";

const locale = Astro.currentLocale ?? config.site.lang;

const work = getWork(locale);

// ItemList schema: exposes the professional roles (current + concluded) to
// search engines and AI crawlers, mirroring llms.txt.
const base = config.site.url.replace(/\/$/, "");
const workJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Work — Wenhao Yu",
  itemListElement: work.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: p.title,
      description: p.description,
      url: p.external ? p.href : `${base}${p.href}`,
      ...(p.repo ? { sameAs: [p.repo] } : {}),
      keywords: p.tags.join(", "),
      author: { "@type": "Person", name: config.site.author, url: base },
    },
  })),
});
---

<Layout
  title={`Work — ${config.site.title}`}
  description="Professional work: leading an enterprise agent platform from 0 to 1, and a concluded AI-SOP assistant case study at AB InBev. Methodology and capability only."
  ogImage="/og/work.png"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={workJsonLd}
    slot="head"
  />
  <Header />
  <Breadcrumb />

  <Main pageTitle="Work" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("zh", "work")}
        class="text-accent hover:underline"
      >
        阅读中文版
      </a>
    </p>

    <p>Professional work, current and concluded.</p>

    <div class="not-prose border-border divide-border mt-8 divide-y border-t">
      {
        work.map(project => (
          <a
            href={project.href}
            class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[1fr_3fr] sm:gap-8"
          >
            <div class="text-muted-foreground text-xs tracking-wide uppercase sm:pt-1">
              {project.ledger?.date ?? project.status}
            </div>
            <div>
              <h2 class="group-hover:text-accent text-lg font-medium transition-colors">
                {project.ledger?.heading ?? project.title}
              </h2>
              {project.ledger?.context && (
                <p class="text-muted-foreground mt-1 text-sm">
                  {project.ledger.context}
                </p>
              )}
              <p class="text-muted-foreground mt-2 text-sm">
                {project.description}
              </p>
              {project.ledger?.tech && (
                <p class="text-muted-foreground/80 mt-2 text-xs">
                  {project.ledger.tech}
                </p>
              )}
              <span class="text-accent mt-3 inline-block text-sm group-hover:underline">
                {project.ledger?.cta ?? "Read more →"}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-12 text-sm">
      These pages describe methodology and capability; internal systems and data
      stay private.
    </p>
  </Main>

  <Footer />
</Layout>
