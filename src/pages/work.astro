---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getWork } from "@/data/projects";

const locale = Astro.currentLocale ?? config.site.lang;

const work = getWork(locale);

// ItemList schema: exposes the professional roles (current + concluded) to
// search engines and AI crawlers, mirroring llms.txt.
const base = config.site.url.replace(/\/$/, "");
const workJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Work — Wenhao Yu",
  itemListElement: work.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: p.title,
      description: p.description,
      url: p.external ? p.href : `${base}${p.href}`,
      ...(p.repo ? { sameAs: [p.repo] } : {}),
      keywords: p.tags.join(", "),
      author: { "@type": "Person", name: config.site.author, url: base },
    },
  })),
});
---

<Layout
  title={`Work — ${config.site.title}`}
  description="Professional work: leading an enterprise agent platform from 0 to 1, and a concluded AI-SOP assistant case study at AB InBev. Methodology and capability, per the confidentiality standard."
  ogImage="/og/work.png"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={workJsonLd}
    slot="head"
  />
  <Header />
  <Breadcrumb />

  <Main pageTitle="Work" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("zh", "work")}
        class="text-accent hover:underline"
      >
        阅读中文版
      </a>
    </p>

    <p>
      Work I do or did in a professional capacity — described at the level of
      methodology and capability, per the confidentiality standard. Current work
      first, concluded work second.
    </p>

    <p class="text-muted-foreground text-sm">
      Some of this work is private due to data and permission constraints. These
      pages abstract the product methodology rather than exposing internal
      systems.
    </p>

    <div class="mt-8 grid gap-6">
      {
        work.map(project => (
          <a
            href={project.href}
            class="border-border group hover:bg-accent/5 rounded-lg border p-6 transition-colors"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="group-hover:text-accent text-xl font-semibold">
                {project.title}
              </h2>
              <span class="text-muted-foreground flex-shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap">
                {project.status}
              </span>
            </div>
            <p class="text-muted-foreground mt-2">{project.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="bg-muted rounded-full px-2.5 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
