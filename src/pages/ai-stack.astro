---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import FlowDiagram from "@/components/FlowDiagram.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const workflow = [
  {
    stage: "Ideation",
    tools: "ChatGPT (primary) + Gemini (divergent exploration)",
    note: "Product framing, brainstorming, structuring ambiguous ideas before any code exists.",
  },
  {
    stage: "Prototyping",
    tools: "Codex (primary) + Claude Code (support)",
    note: "Use coding agents to turn a scoped product idea into a prototype that can be inspected and tested.",
  },
  {
    stage: "Hard debugging",
    tools: "Coding agents + reasoning models",
    note: "Investigate failures, test changes, and review the evidence before deciding what is resolved.",
  },
  {
    stage: "Frontend & CMS pages",
    tools: "Codex app",
    note: "Develop and review frontend and CMS work with code and visual checks.",
  },
  {
    stage: "Daily operations",
    tools: "Agent workflows + MCP tools",
    note: "Research, notes, and repetitive tasks run through agent loops rather than living in my head.",
  },
];

// Short labels for the line-art pipeline overview above the workflow cards.
const flowSteps = [
  { label: "Ideation", note: "frame" },
  { label: "Prototyping", note: "build", emphasis: true },
  { label: "Debugging", note: "hard bugs" },
  { label: "Frontend / CMS", note: "iterate" },
  { label: "Daily ops", note: "automate" },
];

const models = [
  {
    model: "ChatGPT",
    role: "Product ideation (primary)",
    why: "Strongest at divergent thinking and structuring fuzzy product ideas.",
  },
  {
    model: "Gemini",
    role: "Ideation (secondary)",
    why: "A second, differently-biased opinion for exploration.",
  },
  {
    model: "Claude",
    role: "Supporting coding work",
    why: "Claude Code is a supporting tool alongside my primary Codex workflow.",
  },
  {
    model: "DeepSeek",
    role: "Cost-efficient code generation",
    why: "An option for tasks where cost is a consideration.",
  },
  {
    model: "Kimi",
    role: "Long-context assistance",
    why: "Cost-effective for large-codebase or long-document scenarios.",
  },
  {
    model: "Fast lightweight models",
    role: "Agent daily loop",
    why: "My personal agent's conversational layer prioritizes speed and stability over peak IQ.",
  },
];

const boundaries = [
  {
    area: "Frontend prototyping",
    current:
      "Fluent with the Astro + React + shadcn/Radix system; an interactive prototype in 1–2 days.",
    next: "Backend integration and real data flows.",
  },
  {
    area: "Enterprise admin (Vue)",
    current:
      "Can maintain and extend a Vue 3 monorepo admin stack; not my primary lane.",
    next: "Deeper component customization.",
  },
  {
    area: "Animation & 3D",
    current:
      "GSAP + Lenis scroll-driven animation fluently; Three.js (R3F) at a working-basics level.",
    next: "Complex interactive 3D scenes.",
  },
  {
    area: "AI tool orchestration",
    current:
      "Using Codex as my primary coding agent, with Claude Code in a supporting role.",
    next: "Automated routing policies and cost-effectiveness tracking.",
  },
  {
    area: "Knowledge management",
    current:
      "A dual-track system: a persistent long-document knowledge base plus a daily markdown wiki.",
    next: "Periodic linting to keep both healthy.",
  },
];
---

<Layout
  title={`My AI Stack — ${config.site.title}`}
  description="The tools and workflows Wenhao Yu uses across coding agents, language models, and product work, including their limits."
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="My AI Stack" class="app-prose">
    <p>
      I don't use one AI tool for everything. The operating principle is
      <strong>harness engineering</strong>: give every tool the job it is best
      at, and design the handoffs between them. This page documents the actual
      stack I run day to day — and where its edges are.
    </p>
    <h2 class="mt-8 text-xl font-semibold">The Workflow</h2>
    <p>
      These stages are a practical outline; the tools and checks vary by task:
    </p>
    <FlowDiagram steps={flowSteps} />
    <div class="mt-4 space-y-3">
      {
        workflow.map((step, i) => (
          <div class="border-border rounded-lg border p-5">
            <div class="flex items-baseline gap-3">
              <span class="text-accent font-mono text-sm">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-medium">{step.stage}</h3>
                <p class="text-accent mt-0.5 text-sm">{step.tools}</p>
                <p class="text-muted-foreground mt-1.5 text-sm">{step.note}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 text-xl font-semibold">Coding Tools</h2>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>Codex — primary.</strong> My main coding agent for product work.
      </li>
      <li>
        <strong>Claude Code CLI — support.</strong> A supporting coding tool alongside
        Codex.
      </li>
      <li>
        <strong>Cursor — additional editor.</strong> An editor available for prototype
        work when useful.
      </li>
    </ul>

    <h2 class="mt-8 text-xl font-semibold">Model Routing</h2>
    <div class="mt-4 space-y-3">
      {
        models.map(m => (
          <div class="border-border rounded-lg border p-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-medium">{m.model}</h3>
              <span class="text-accent text-sm">{m.role}</span>
            </div>
            <p class="text-muted-foreground mt-1.5 text-sm">{m.why}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 text-xl font-semibold">Build Stack</h2>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>Frontend (primary):</strong> Astro + React, Tailwind CSS, shadcn/ui
        on Radix primitives
      </li>
      <li>
        <strong>Enterprise admin:</strong> Vue 3 on a pnpm-monorepo admin framework
        (turborepo tooling chain)
      </li>
      <li>
        <strong>Backend:</strong> Python + FastAPI, Neo4j + NetworkX for graph/ontology
        work, Node.js for API automation
      </li>
      <li>
        <strong>Motion & 3D:</strong> GSAP + Lenis for scroll-driven storytelling,
        React Three Fiber for 3D
      </li>
      <li>
        <strong>Deploy:</strong> GitHub Pages and Vercel via CI, Docker Compose where
        a real backend is involved
      </li>
    </ul>

    <h2 class="mt-8 text-xl font-semibold">
      Agent Platform Product Design (0 → 1)
    </h2>
    <p>
      At my current job, I lead product design for an enterprise agent platform
      from its initial concept through delivery to customers within the group.
      My work includes PRDs, competitor analysis, customer feedback, and
      coding-agent-assisted prototypes that help the engineering team align on
      implementation. External customer delivery is being prepared, while
      adaptation for China's domestic IT ecosystem is in progress. The product
      belongs to my employer, so I focus here on transferable design patterns.
    </p>
    <p>Agentic design decisions I owned:</p>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>Dual-mode architecture:</strong> a business workspace for frontline
        users and a developer console for builders, one click apart — the same platform
        has to read completely differently to each audience
      </li>
      <li>
        <strong>Layered asset model:</strong> tools (atomic calls) → skills (smallest
        executable capability) → agents (model + prompt + knowledge + data + tools
        + skills), each versioned so expertise survives staff turnover
      </li>
      <li>
        <strong>Conversational skill creation:</strong> business users describe a
        need in natural language; the system asks clarifying questions, renders a
        live logic blueprint of the execution steps, then generates code, configuration,
        and documentation together
      </li>
      <li>
        <strong>Governance by design:</strong> dev/prod sandbox isolation, simulated
        execution, human-in-the-loop approval for high-risk actions, capability switches,
        and release reviews — unchecked AI output never touches production systems
      </li>
      <li>
        <strong>Grounded configuration:</strong> agents draw on knowledge bases plus
        terminology glossaries so outputs match enterprise vocabulary, with per-skill
        confirm-before-execute options and explicit switches for clarifying questions
        and web search
      </li>
      <li>
        <strong>Automation orchestration:</strong> webhook, message-queue, and scheduled
        triggers on a visual flow canvas, with low-confidence branches routed to human
        approval instead of guessing
      </li>
    </ul>

    <h2 class="mt-8 text-xl font-semibold">Beyond Coding</h2>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>Dual-track knowledge management:</strong> a locally deployed long-document
        knowledge base (MCP-connected) plus a markdown wiki that threads together
        daily fragments — screenshots, papers, prompts
      </li>
      <li>
        <strong>MCP integrations:</strong> browser automation and web-crawling tools
        wired into the agent loop
      </li>
      <li>
        <strong>Enterprise AI enablement:</strong> ran 4 internal training sessions
        bringing agent workflows to non-technical teams (strategy, finance, legal)
      </li>
    </ul>

    <h2 class="mt-8 text-xl font-semibold">Honest Capability Boundaries</h2>
    <p>
      A stack page that only lists strengths is marketing. Here is where the
      edges actually are:
    </p>
    <div class="mt-4 space-y-3">
      {
        boundaries.map(b => (
          <div class="border-border rounded-lg border p-5">
            <h3 class="font-medium">{b.area}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm">{b.current}</p>
            <p class="mt-1.5 text-sm">
              <span class="text-accent font-medium">Next: </span>
              <span class="text-muted-foreground">{b.next}</span>
            </p>
          </div>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-8 text-sm">
      Core principle: find the combination that actually works for you, keep
      using it, and make sure it keeps earning its place.
    </p>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">Related</h2>
      <div class="mt-3 flex flex-wrap gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "playbook/harness-engineering")}
          class="text-accent hover:underline"
        >
          Harness Engineering Methodology
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "playbook/vibe-coding")}
          class="text-accent hover:underline"
        >
          Vibe Coding Methodology
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="text-accent hover:underline"
        >
          Projects
        </a>
      </div>
    </div>
  </Main>

  <Footer />
</Layout>
