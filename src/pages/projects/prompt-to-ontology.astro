---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import FlowDiagram from "@/components/FlowDiagram.astro";
import ScreenshotGallery from "@/components/ScreenshotGallery.astro";
import type { Shot } from "@/components/ScreenshotGallery.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

import dashboard from "@/assets/projects/prompt-to-ontology/dashboard.png";
import dataPipeline from "@/assets/projects/prompt-to-ontology/data-pipeline.png";
import ontologyManager from "@/assets/projects/prompt-to-ontology/ontology-manager.png";
import graph from "@/assets/projects/prompt-to-ontology/graph.png";
import analystAgent from "@/assets/projects/prompt-to-ontology/analyst-agent.png";
import reviewQueue from "@/assets/projects/prompt-to-ontology/review-queue.png";

const walkthrough: Shot[] = [
  {
    src: dashboard,
    alt: "Operational ontology runtime dashboard",
    caption:
      "Pet Food demo dashboard — an overview of the sample ontology and review workflow.",
  },
  {
    src: dataPipeline,
    alt: "Data pipeline: select, profile, map, validate, import",
    caption:
      "Data Pipeline — profile sample CSV, map fields to ontology types, validate candidates, and prepare an import plan.",
  },
  {
    src: ontologyManager,
    alt: "Ontology schema manager with object types, relations, rules, actions",
    caption:
      "Ontology Manager — inspect object and relationship types, constraints, rules, and actions defined in the schema.",
  },
  {
    src: graph,
    alt: "Interactive knowledge graph explorer",
    caption:
      "Graph Explorer — inspect typed objects, relationships, and rule evidence in the runtime graph.",
  },
  {
    src: analystAgent,
    alt: "Analyst agent answering questions via ontology tools",
    caption:
      "Analyst Agent — uses ontology tools, records a trace, and proposes changes for review rather than writing directly to the graph.",
  },
  {
    src: reviewQueue,
    alt: "Human-in-the-loop review queue",
    caption:
      "Review Queue — proposed imports and agent suggestions can be approved or rejected before application.",
  },
];

const architectureSteps = [
  { label: "Sample CSV", note: "ready data" },
  { label: "Profile & Map", note: "typed candidates" },
  { label: "Import Plan", note: "human review", emphasis: true },
  { label: "Runtime Graph", note: "objects · links" },
  { label: "Rules & Evidence", note: "four result states" },
  { label: "Analyst Agent", note: "tool use · trace", emphasis: true },
  { label: "Governance", note: "snapshot · diff · rollback" },
];

const snapshot = [
  {
    label: "Type",
    value: "Learning project · runnable reference implementation",
  },
  { label: "Stack", value: "React · FastAPI · Neo4j · YAML rules" },
  { label: "Scope", value: "Pet Food sample domain · local guided demo" },
  { label: "Status", value: "Open source · maintenance-focused" },
];
---

<Layout
  title={`Prompt-to-Ontology — ${config.site.title}`}
  description="A runnable Pet Food reference for operational ontologies: typed graph objects, explicit rule evidence, reviewed imports and agent suggestions, and reversible changes."
  ogImage="/og/prompt-to-ontology.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Prompt-to-Ontology" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("zh", "projects/prompt-to-ontology")}
        class="text-accent hover:underline"
      >
        阅读中文版
      </a>
    </p>

    <p class="text-muted-foreground text-lg">
      A learning-by-building reference for operational ontologies. The Pet Food
      demo connects structured data to typed graph objects, explicit rules,
      human review, and an ontology-grounded Analyst Agent.
    </p>

    <div class="border-border mt-4 flex flex-wrap gap-2">
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Typed ontology
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Neo4j
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Rule evidence
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Human review
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Snapshot &amp; rollback
      </span>
    </div>

    <div
      class="border-border bg-border mt-6 grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2"
    >
      {
        snapshot.map(item => (
          <div class="bg-background p-4">
            <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
              {item.label}
            </p>
            <p class="mt-1 text-sm">{item.value}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 text-xl font-semibold">The question</h2>
    <p>
      What has to happen between a CSV file and an agent action for a graph to
      carry usable business meaning? I built one sample workflow to examine the
      product decisions behind that question: what gets typed, which rules can
      be evaluated, what evidence an answer needs, and who approves a change.
    </p>

    <h2 class="mt-6 text-xl font-semibold">What the reference implements</h2>
    <p>
      The Pet Food demo profiles structured data and maps it against a YAML
      schema of object types, relationships, constraints, rules, and actions. A
      reviewable import plan comes before graph writes. In the runtime, people
      can inspect objects, explore links, run rule simulations, and see evidence
      attached to results. The Analyst Agent queries through ontology tools and
      proposes updates; the Review Queue controls whether they are applied.
    </p>
    <FlowDiagram
      steps={architectureSteps}
      caption="The guided Pet Food demo follows one path from sample data to reviewed, traceable graph changes."
    />

    <h2 class="mt-8 text-xl font-semibold">Product walkthrough</h2>
    <p>
      These screens are from the runnable local demo. Click a screenshot to see
      how data preparation, graph inspection, agent traces, and review connect.
    </p>
    <ScreenshotGallery images={walkthrough} />

    <div
      class="border-border bg-muted/30 mt-6 flex flex-col gap-3 rounded-lg border p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="font-medium">See the ontology come alive</p>
        <p class="text-muted-foreground text-sm">
          Explore the knowledge graph as an interactive 3D scene — orbit, zoom,
          and inspect every entity and relationship.
        </p>
      </div>
      <a
        href={getRelativeLocaleUrl("en", "projects/ontology-graph")}
        class="bg-accent text-accent-foreground inline-flex shrink-0 items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
      >
        Explore in 3D &rarr;
      </a>
    </div>

    <h2 class="mt-8 text-xl font-semibold">The decisions I wanted to test</h2>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>Make rules inspectable.</strong> A result can be triggered, passed,
        not evaluable, or not applicable. Missing data should remain visible rather
        than becoming a false claim of safety.
      </li>
      <li>
        <strong>Put review before mutation.</strong> Imports and agent suggestions
        go through a human approval step. Snapshots, diffs, and rollback make graph
        changes traceable and reversible.
      </li>
      <li>
        <strong>Keep the agent grounded.</strong> It uses ontology tools and a structured
        trace. The demo runs in deterministic fallback mode without an external LLM
        key; LLM-powered reasoning is optional.
      </li>
    </ul>

    <h2 class="mt-6 text-xl font-semibold">Scope and next steps</h2>
    <p>
      This is a learning project with one Pet Food sample domain, not a
      production deployment or proof that the design works across industries.
      The repository includes a guided demo, module checks, and frontend smoke
      tests. I am maintaining it as a reference rather than expanding it into a
      general-purpose enterprise platform.
    </p>
    <p>
      The related <a
        href={getRelativeLocaleUrl(locale, "posts/building-ontology-os")}
        class="text-accent hover:underline">build note</a
      >
      explains the product tradeoffs in more detail; the <a
        href={getRelativeLocaleUrl(locale, "playbook/prompt-to-ontology")}
        class="text-accent hover:underline">method note</a
      >
      turns those decisions into a reusable checklist.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="https://github.com/wenhaoyu-bryan/prompt-to-ontology"
        class="bg-accent text-accent-foreground inline-flex items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
      </a>
      <a
        href={getRelativeLocaleUrl(
          config.site.lang,
          "posts/building-ontology-os"
        )}
        class="border-border text-foreground hover:bg-accent/10 inline-flex items-center gap-1.5 rounded-md border px-5 py-2.5 text-sm font-medium transition-colors"
      >
        Read the Blog Post
      </a>
    </div>
  </Main>

  <Footer />
</Layout>
