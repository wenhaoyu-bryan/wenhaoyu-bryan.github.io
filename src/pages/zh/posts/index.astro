---
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);

const playbookItems = [
  {
    label: "Harness Engineering",
    href: getRelativeLocaleUrl("zh", "playbook/harness-engineering"),
  },
  {
    label: "Loop Engineering",
    href: getRelativeLocaleUrl("zh", "playbook/loop-engineering"),
  },
  {
    label: "Prompt-to-Ontology",
    href: getRelativeLocaleUrl("zh", "playbook/prompt-to-ontology"),
  },
];

const ontologyTranslation = await getEntry("pages", "building-ontology-os-zh");
const featured = [
  {
    slug: "building-ontology-os",
    title: ontologyTranslation?.data.title ?? "构建可审查的本体原型",
    summary:
      "从 Pet Food 演示出发，记录规则证据、人工审核和图谱回滚为什么要进入产品流程。",
    href: getRelativeLocaleUrl("zh", "posts/building-ontology-os"),
    project: getRelativeLocaleUrl("zh", "projects/prompt-to-ontology"),
  },
  {
    slug: "three-frameworks-ai-assisted-product-delivery",
    summary: "用 Harness、Loop 和 Vibe Coding 三个视角拆解 AI 辅助的产品交付。",
  },
  {
    slug: "what-changes-when-pm-meets-ai-agents",
    summary: "从制造业场景出发，讨论智能体产品需要怎样的上下文、权限与评估。",
  },
];
const featuredPosts = featured.flatMap(item => {
  const post = posts.find(
    post => getPostSlug(post.id, post.filePath) === `/${item.slug}`
  );
  return post ? [{ ...item, post }] : [];
});
const otherPosts = posts.filter(
  post =>
    !featured.some(
      item => `/${item.slug}` === getPostSlug(post.id, post.filePath)
    )
);

// Growth Lab status chip — derived from the experiment list (00 concluded,
// 01 instrumented and collecting a baseline).
const growthExperiments = [{ status: "Concluded" }, { status: "Instrumented" }];
const activeCount = growthExperiments.filter(
  e => e.status !== "Concluded"
).length;
const growthChip = `${growthExperiments.length} 个实验 · ${activeCount} 个进行中`;
---

<Layout
  title={`思考 — ${config.site.title}`}
  description="关于产品系统、本体、智能体与增长的文章、方法与工作笔记。"
  ogImage="/og/thinking.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="思考" class="max-w-3xl">
    <p class="text-muted-foreground mt-2 mb-8">
      这里收录关于产品系统、本体、智能体与增长的文章、方法和工作笔记。
    </p>

    <!-- Essays first, with the available Chinese translation linked directly. -->
    <section>
      <h2 class="text-xl font-semibold">精选文章</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        从具体项目和问题出发的复盘。英文原文会标注语言。
      </p>
      <div class="mt-4 space-y-3">
        {
          featuredPosts.map(item => (
            <article class="border-border rounded-lg border p-4">
              <a
                href={
                  item.href ??
                  getPostUrl(item.post.id, item.post.filePath, "en")
                }
                class="text-accent font-medium hover:underline"
              >
                {item.title ?? `${item.post.data.title}（英文）`}
              </a>
              <p class="text-muted-foreground mt-2 text-sm">{item.summary}</p>
              <div class="text-muted-foreground mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                <Datetime
                  pubDatetime={item.post.data.pubDatetime}
                  modDatetime={item.post.data.modDatetime}
                  size="sm"
                />
                {item.project && (
                  <a href={item.project} class="text-accent hover:underline">
                    查看相关项目 →
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
      <h3 class="mt-8 font-semibold">更多文章</h3>
      <ul class="mt-3 space-y-3">
        {
          otherPosts.map(post => (
            <li class="flex flex-wrap items-baseline justify-between gap-2">
              <a
                href={getPostUrl(post.id, post.filePath, "en")}
                class="text-accent text-sm hover:underline"
              >
                {`${post.data.title}（英文）`}
              </a>
              <Datetime
                pubDatetime={post.data.pubDatetime}
                modDatetime={post.data.modDatetime}
                size="sm"
                class="text-muted-foreground shrink-0 text-xs"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- A few entry points; the complete index remains on the method page. -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">方法论</h2>
        <a
          href={getRelativeLocaleUrl("zh", "playbook")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          全部方法论 →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        这些方法从项目实践中整理出来，完整目录在方法论页面。
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          playbookItems.map(item => (
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 text-xs">&#x2022;</span>
              <a href={item.href} class="text-accent text-sm hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Growth Lab -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">Growth Lab</h2>
        <a
          href={getRelativeLocaleUrl("zh", "growth-lab")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          打开笔记 →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        一本公开的实验笔记 —— 从假设到度量。
      </p>
      <a
        href={getRelativeLocaleUrl("zh", "growth-lab")}
        class="border-border group hover:bg-accent/5 mt-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-lg border p-4 transition-colors"
      >
        <span class="group-hover:text-accent font-medium transition-colors">
          公开进行的 SEO 与 GEO 增长实验
        </span>
        <span
          class="border-border text-muted-foreground shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap"
        >
          {growthChip}
        </span>
      </a>
    </section>
  </Main>

  <Footer />
</Layout>
