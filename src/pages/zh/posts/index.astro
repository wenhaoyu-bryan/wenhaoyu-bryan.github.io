---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

// Shelf 1 — essays. Blog posts are en-only, so links point at the en routes.
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);

// Shelf 2 — the live Playbook methodology pages (mirrors zh/playbook.astro).
const playbookItems = [
  {
    label: "Vibe Coding for Product Discovery",
    href: getRelativeLocaleUrl("zh", "playbook/vibe-coding"),
  },
  {
    label: "Harness Engineering",
    href: getRelativeLocaleUrl("zh", "playbook/harness-engineering"),
  },
  {
    label: "Loop Engineering",
    href: getRelativeLocaleUrl("zh", "playbook/loop-engineering"),
  },
  {
    label: "AI-Native PRD",
    href: getRelativeLocaleUrl("zh", "playbook/ai-native-prd"),
  },
  {
    label: "PRD 到原型工作流",
    href: getRelativeLocaleUrl("zh", "playbook/prd-to-prototype"),
  },
  {
    label: "Agent 产品设计框架",
    href: getRelativeLocaleUrl("zh", "playbook/agent-product-design"),
  },
  {
    label: "Prompt-to-Ontology",
    href: getRelativeLocaleUrl("zh", "playbook/prompt-to-ontology"),
  },
];
---

<Layout
  title={`写作 — ${config.site.title}`}
  description="我写作与维护的一切，都集中在这里：随笔与工作笔记、一套常青的 AI 产品经理方法论手册，以及一本公开的增长实验笔记。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="写作" class="max-w-3xl">
    <p class="text-muted-foreground -mt-4 mb-8">
      三个板块，集中一处 ——
      随笔与工作笔记、一套常青的方法论手册，以及一本公开的增长实验笔记。
    </p>

    <!-- Posts -->
    <section>
      <h2 class="text-xl font-semibold">文章</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        关于 AI 产品管理的随笔与工作笔记（英文）。
      </p>
      <ul class="border-border mt-4 divide-y rounded-lg border">
        {
          posts.map(post => (
            <li>
              <a
                href={getPostUrl(post.id, post.filePath, "en")}
                class="group hover:bg-accent/5 block p-4 transition-colors"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <span class="group-hover:text-accent font-medium transition-colors">
                    {post.data.title}
                  </span>
                  <Datetime
                    pubDatetime={post.data.pubDatetime}
                    modDatetime={post.data.modDatetime}
                    size="sm"
                    class="text-muted-foreground shrink-0 text-xs"
                  />
                </div>
                <p class="text-muted-foreground mt-1 line-clamp-2 text-sm">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Playbook -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">Playbook</h2>
        <a
          href={getRelativeLocaleUrl("zh", "playbook")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          全部方法论 →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        常青方法论：我如何开展 AI 辅助的产品工作。
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          playbookItems.map(item => (
            <li class="flex items-start gap-2">
              <span class="text-accent mt-1 text-xs">&#x2022;</span>
              <a href={item.href} class="text-accent text-sm hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Growth Lab -->
    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">Growth Lab</h2>
        <a
          href={getRelativeLocaleUrl("zh", "growth-lab")}
          class="text-accent shrink-0 text-sm hover:underline"
        >
          打开笔记 →
        </a>
      </div>
      <p class="text-muted-foreground mt-1 text-sm">
        一本公开的实验笔记 —— 从假设到度量。
      </p>
      <a
        href={getRelativeLocaleUrl("zh", "growth-lab")}
        class="border-border group hover:bg-accent/5 mt-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 rounded-lg border p-4 transition-colors"
      >
        <span class="group-hover:text-accent font-medium transition-colors">
          公开进行的 SEO 与 GEO 增长实验
        </span>
        <span
          class="border-border text-muted-foreground shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap"
        >
          2 个实验 · 1 个进行中
        </span>
      </a>
    </section>
  </Main>

  <Footer />
</Layout>
