---
import { getEntry } from "astro:content";
import PostPage from "@/pages/posts/[...slug]/index.astro";
const post = await getEntry("posts", "seo-to-geo-how-ai-search-changes-growth");
const translation = await getEntry(
  "pages",
  "seo-to-geo-how-ai-search-changes-growth-zh"
);
if (!post || !translation)
  throw new Error(
    "Missing essay or translation: seo-to-geo-how-ai-search-changes-growth"
  );
---

<PostPage {post} {translation} prevPost={null} nextPost={null} />
