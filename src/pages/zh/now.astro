---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// 每次改动本页内容时，更新这个日期。
const lastUpdated = "2026 年 11 月 19 日";

const building = [
  "主导企业级 Agent 平台产品设计：平台已向集团内部客户交付，正在筹备外部客户交付并推进信创适配。",
  "与同事协作，通过可审查的原型探索本体和知识工作流。",
  "维护这个双语作品集，持续整理和发布 AI 产品工作笔记。",
];

const exploring = [
  "Ontology 和知识图谱如何让企业 AI 更可靠、更可运营。",
  "多智能体会话与编排者—工作者架构如何支持协作与治理。",
  "PM 如何用 Vibe Coding 更快验证想法，并给工程团队交付一份可运行的蓝图。",
  "AI 搜索（GEO）如何改变产品被发现和被采用的方式。",
  "编码智能体如何让产品交接和实现评审更加清晰。",
];

const shipped = [
  "为全部六篇已发布博客补充中文版本，并提供中英文互相切换。",
  "为长篇博客和方法论页面增加文章目录与预计阅读时间。",
  "上线 Agent Anatomy：一个用交互式视觉长文解释 AI 智能体的系列。",
  "更新企业级 Agent 平台案例，区分集团内部客户交付与仍在推进的工作。",
];
---

<Layout
  title={`Now · 我在做什么 — ${config.site.title}`}
  description="Wenhao Yu 现在正在专注什么——当前项目、正在探索的方向，以及最近上线的工作。遵循 nownownow.com 惯例的 now 页面。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Now · 我在做什么" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "now")}
        class="text-accent hover:underline"
      >
        Read this page in English
      </a>
    </p>
    <p class="text-muted-foreground text-sm">
      我现在正在专注的事。这是一个
      <a href="https://nownownow.com/about" class="text-accent hover:underline"
        >now 页面</a
      >——一张快照，而不是变更日志。最后更新于 {lastUpdated}。
    </p>

    <h2 class="mt-8 text-xl font-semibold">正在构建</h2>
    <ul class="mt-2 space-y-2">
      {building.map(item => <li>{item}</li>)}
    </ul>

    <h2 class="mt-8 text-xl font-semibold">正在探索</h2>
    <ul class="mt-2 space-y-2">
      {exploring.map(item => <li>{item}</li>)}
    </ul>

    <h2 class="mt-8 text-xl font-semibold">最近上线</h2>
    <ul class="mt-2 space-y-2">
      {shipped.map(item => <li>{item}</li>)}
    </ul>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">其他去处</h2>
      <div class="mt-3 flex flex-wrap gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "ai-stack")}
          class="text-accent hover:underline"
        >
          我的 AI 工具栈
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class="text-accent hover:underline"
        >
          项目
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-accent hover:underline"
        >
          关于
        </a>
      </div>
    </div>
  </Main>

  <Footer />
</Layout>
