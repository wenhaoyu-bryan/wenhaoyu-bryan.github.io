---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import FlowDiagram from "@/components/FlowDiagram.astro";
import ScreenshotGallery from "@/components/ScreenshotGallery.astro";
import type { Shot } from "@/components/ScreenshotGallery.astro";
import config from "@/config";

import dashboard from "@/assets/projects/prompt-to-ontology/dashboard.png";
import dataPipeline from "@/assets/projects/prompt-to-ontology/data-pipeline.png";
import ontologyManager from "@/assets/projects/prompt-to-ontology/ontology-manager.png";
import graph from "@/assets/projects/prompt-to-ontology/graph.png";
import analystAgent from "@/assets/projects/prompt-to-ontology/analyst-agent.png";
import reviewQueue from "@/assets/projects/prompt-to-ontology/review-queue.png";

const walkthrough: Shot[] = [
  {
    src: dashboard,
    alt: "运营本体运行时仪表盘",
    caption: "Pet Food 演示仪表盘 —— 查看样例本体和审核流程的运行概况。",
  },
  {
    src: dataPipeline,
    alt: "数据管线：选择、剖析、映射、校验、导入",
    caption:
      "数据管线 —— 剖析样例 CSV、映射本体类型、校验候选项并生成待审导入计划。",
  },
  {
    src: ontologyManager,
    alt: "本体 Schema 管理：对象类型、关系、规则、动作",
    caption:
      "本体管理 —— 查看 Schema 中定义的对象与关系类型、约束、规则和动作。",
  },
  {
    src: graph,
    alt: "交互式知识图谱浏览器",
    caption: "图谱浏览器 —— 检查运行时对象、关系及规则证据。",
  },
  {
    src: analystAgent,
    alt: "分析 Agent 通过本体工具回答问题",
    caption:
      "分析 Agent —— 调用本体工具、记录执行轨迹，并提出需审核的修改建议，不直接写入图谱。",
  },
  {
    src: reviewQueue,
    alt: "人工确认审查队列",
    caption: "审查队列 —— 导入计划与 Agent 建议在应用前由人批准或驳回。",
  },
];

const architectureSteps = [
  { label: "样例 CSV", note: "待处理数据" },
  { label: "剖析与映射", note: "带类型的候选项" },
  { label: "导入计划", note: "人工审核", emphasis: true },
  { label: "运行时图谱", note: "对象 · 关系" },
  { label: "规则与证据", note: "四种结果状态" },
  { label: "分析 Agent", note: "工具调用 · 轨迹", emphasis: true },
  { label: "图谱治理", note: "快照 · 差异 · 回滚" },
];

const snapshot = [
  { label: "类型", value: "学习项目 · 可运行参考实现" },
  { label: "技术栈", value: "React · FastAPI · Neo4j · YAML 规则" },
  { label: "范围", value: "Pet Food 样例领域 · 本地引导演示" },
  { label: "状态", value: "开源 · 以维护为主" },
];
---

<Layout
  title={`Prompt-to-Ontology · 案例研究 — ${config.site.title}`}
  description="Pet Food 可运行参考实现：带类型的本体图谱、明确的规则证据、经人工审核的导入与 Agent 建议，以及可回滚的变更。"
  ogImage="/og/prompt-to-ontology.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Prompt-to-Ontology" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "projects/prompt-to-ontology")}
        class="text-accent hover:underline"
      >
        Read this page in English
      </a>
    </p>

    <p class="text-muted-foreground text-lg">
      一个通过动手构建来研究运营型本体的参考实现。Pet Food
      演示把结构化数据、带类型的图谱对象、明确的规则、人工审核与基于本体工具的分析
      Agent 连起来。
    </p>

    <div class="border-border mt-4 flex flex-wrap gap-2">
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        带类型的本体
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        Neo4j
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        规则证据
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        人工审核
      </span>
      <span class="rounded-full border px-3 py-1 text-xs font-medium">
        快照与回滚
      </span>
    </div>

    <div
      class="border-border bg-border mt-6 grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2"
    >
      {
        snapshot.map(item => (
          <div class="bg-background p-4">
            <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
              {item.label}
            </p>
            <p class="mt-1 text-sm">{item.value}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-8 text-xl font-semibold">我想验证的问题</h2>
    <p>
      从一份 CSV 到一次 Agent
      操作，中间需要哪些环节，图谱里的信息才有可用的业务含义？
      我用一个样例流程检查这些产品决策：对象如何定型，哪些规则能被计算，回答需要什么证据，变更由谁批准。
    </p>

    <h2 class="mt-6 text-xl font-semibold">参考实现包含什么</h2>
    <p>
      Pet Food 演示先剖析结构化数据，再按 YAML Schema
      映射对象类型、关系、约束、规则与动作。写入图谱前会形成待审导入计划。进入运行时后，可以查看对象、探索关系、模拟规则并检查结果证据。分析
      Agent 通过本体工具查询和提出修改建议；是否应用，由审查队列控制。
    </p>
    <FlowDiagram
      steps={architectureSteps}
      caption="Pet Food 引导演示的一条路径：从样例数据到经过审核、可追溯的图谱变更。"
    />

    <h2 class="mt-8 text-xl font-semibold">产品实景</h2>
    <p>
      以下截图来自可在本地运行的演示。点击可放大，查看数据准备、图谱检查、Agent
      轨迹和人工审核如何衔接。
    </p>
    <ScreenshotGallery images={walkthrough} />

    <div
      class="border-border bg-muted/30 mt-6 flex flex-col gap-3 rounded-lg border p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="font-medium">在 3D 中探索这套本体</p>
        <p class="text-muted-foreground text-sm">
          将知识图谱作为可交互的 3D 场景来探索 ——
          自由旋转、缩放，并查看每一个实体与关系（英文界面）。
        </p>
      </div>
      <a
        href={getRelativeLocaleUrl("en", "projects/ontology-graph")}
        class="bg-accent text-accent-foreground inline-flex shrink-0 items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
      >
        进入 3D 图谱 &rarr;
      </a>
    </div>

    <h2 class="mt-8 text-xl font-semibold">我想检验的设计选择</h2>
    <ul class="mt-2 space-y-2">
      <li>
        <strong>让规则结果可检查。</strong
        >结果分为触发、通过、无法评估、不适用四种状态。缺少数据时应明确显示，而不能被误读为安全。
      </li>
      <li>
        <strong>先审核，再修改。</strong>导入和 Agent
        建议先经过人工确认；快照、差异和回滚让图谱变更可追溯、可撤销。
      </li>
      <li>
        <strong>让 Agent 有依据地工作。</strong
        >它调用本体工具并留下结构化轨迹。演示默认不需要外部 LLM
        Key，以确定性回退模式运行；模型推理是可选配置。
      </li>
    </ul>

    <h2 class="mt-6 text-xl font-semibold">项目边界</h2>
    <p>
      这是一个只覆盖 Pet Food
      样例领域的学习项目，不是生产部署，也不能证明它可直接适用于其他行业。仓库提供引导演示、后端模块检查和前端冒烟测试。目前我把它作为参考实现维护，不计划把它扩展成通用企业平台。
    </p>
    <p>
      相关的<a
        href={getRelativeLocaleUrl("zh", "posts/building-ontology-os")}
        class="text-accent hover:underline">构建笔记</a
      >记录了更具体的产品取舍；<a
        href={getRelativeLocaleUrl("zh", "playbook/prompt-to-ontology")}
        class="text-accent hover:underline">方法笔记</a
      >把它整理成可复用的检查清单。
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="https://github.com/wenhaoyu-bryan/prompt-to-ontology"
        class="bg-accent text-accent-foreground inline-flex items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
        target="_blank"
        rel="noopener noreferrer"
      >
        在 GitHub 上查看
      </a>
      <a
        href={getRelativeLocaleUrl("zh", "posts/building-ontology-os")}
        class="border-border text-foreground hover:bg-accent/10 inline-flex items-center gap-1.5 rounded-md border px-5 py-2.5 text-sm font-medium transition-colors"
      >
        阅读相关博文
      </a>
    </div>
  </Main>

  <Footer />
</Layout>
