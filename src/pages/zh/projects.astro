---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getListedBuilds } from "@/data/projects";

const projects = getListedBuilds("zh");
---

<Layout
  title={`项目 — ${config.site.title}`}
  description="我在开放环境下自主构建并维护的东西：Prompt-to-Ontology、Agent Anatomy、AI PM Playbook，以及增长实验。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="项目" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "projects")}
        class="text-accent hover:underline"
      >
        Read in English
      </a>
    </p>

    <p>
      我在开放环境下自主构建并维护的东西 ——
      为了真正好用，而不只是拿来展示：本体驱动系统、交互式解释器、一套 AI PM
      工具集，以及增长实验。
    </p>

    <p class="text-muted-foreground text-sm">
      想看我的职业经历？那些放在
      <a
        href={getRelativeLocaleUrl("zh", "work")}
        class="text-accent hover:underline">工作</a
      >
      板块。
    </p>

    <div class="mt-8 grid gap-6">
      {
        projects.map(project => (
          <a
            href={project.href}
            class="border-border group hover:bg-accent/5 rounded-lg border p-6 transition-colors"
            {...(project.href.startsWith("http")
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <div class="flex items-center justify-between">
              <h2 class="group-hover:text-accent text-xl font-semibold">
                {project.title}
              </h2>
              <span class="text-muted-foreground rounded-full border px-2.5 py-0.5 text-xs">
                {project.status}
              </span>
            </div>
            <p class="text-muted-foreground mt-2">{project.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="bg-muted rounded-full px-2.5 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
