---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectShowcase from "@/components/home/ProjectShowcase.astro";
import config from "@/config";
import { getListedBuilds } from "@/data/projects";

const projects = getListedBuilds("zh");
---

<Layout
  title={`项目 — ${config.site.title}`}
  description="两个公开构建项目：Prompt-to-Ontology 与 Agent Anatomy。产品增长实验另见 Growth Lab。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="项目" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "projects")}
        class="text-accent hover:underline"
      >
        Read in English
      </a>
    </p>

    <p>一个可运行的本体原型，一篇可以动手探索 Agent 循环的文章。</p>

    <p class="text-muted-foreground text-sm">
      想看我的职业经历？那些放在
      <a
        href={getRelativeLocaleUrl("zh", "work")}
        class="text-accent hover:underline">工作</a
      >
      板块。
    </p>

    <div class="mt-8">
      <ProjectShowcase {projects} locale="zh" />
    </div>
  </Main>

  <Footer />
</Layout>
