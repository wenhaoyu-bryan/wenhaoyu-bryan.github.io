---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getWork } from "@/data/projects";

const work = getWork("zh");
---

<Layout
  title={`工作 — ${config.site.title}`}
  description="以专业身份做过或正在做的工作：从 0 到 1 领导一个企业级 Agent 平台，以及在百威（AB InBev）的一段已结束的 AI-SOP 助手案例研究。只在方法论与能力层面描述。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="工作" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "work")}
        class="text-accent hover:underline"
      >
        Read in English
      </a>
    </p>

    <p>专业工作，进行中与已结束。</p>

    <div class="not-prose border-border divide-border mt-8 divide-y border-t">
      {
        work.map(project => (
          <a
            href={project.href}
            class="group grid grid-cols-1 gap-2 py-6 sm:grid-cols-[1fr_3fr] sm:gap-8"
          >
            <div class="text-muted-foreground text-xs tracking-wide uppercase sm:pt-1">
              {project.ledger?.date ?? project.status}
            </div>
            <div>
              <h2 class="group-hover:text-accent text-lg font-medium transition-colors">
                {project.ledger?.heading ?? project.title}
              </h2>
              {project.ledger?.context && (
                <p class="text-muted-foreground mt-1 text-sm">
                  {project.ledger.context}
                </p>
              )}
              <p class="text-muted-foreground mt-2 text-sm">
                {project.description}
              </p>
              {project.ledger?.tech && (
                <p class="text-muted-foreground/80 mt-2 text-xs">
                  {project.ledger.tech}
                </p>
              )}
              <span class="text-accent mt-3 inline-block text-sm group-hover:underline">
                {project.ledger?.cta ?? "查看详情 →"}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-12 text-sm">
      这些页面只描述方法论与能力；内部系统与数据不公开。
    </p>
  </Main>

  <Footer />
</Layout>
