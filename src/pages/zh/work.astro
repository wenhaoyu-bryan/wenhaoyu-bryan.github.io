---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { getWork } from "@/data/projects";

const work = getWork("zh");
---

<Layout
  title={`工作 — ${config.site.title}`}
  description="以专业身份做过或正在做的工作：从 0 到 1 领导一个企业级 Agent 平台，以及在百威（AB InBev）的一段已结束的 AI-SOP 助手案例研究。只在方法论与能力层面描述，遵循保密标准。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="工作" class="app-prose">
    <p class="text-muted-foreground text-sm">
      <a
        href={getRelativeLocaleUrl("en", "work")}
        class="text-accent hover:underline"
      >
        Read in English
      </a>
    </p>

    <p>
      我以专业身份做过或正在做的工作 ——
      只在方法论与能力层面描述，遵循保密标准。当前工作在前，已结束的在后。
    </p>

    <p class="text-muted-foreground text-sm">
      其中部分工作出于数据权限和保密要求并不公开。这些页面展示的是抽象后的产品方法论，而非内部系统。
    </p>

    <div class="mt-8 grid gap-6">
      {
        work.map(project => (
          <a
            href={project.href}
            class="border-border group hover:bg-accent/5 rounded-lg border p-6 transition-colors"
          >
            <div class="flex items-center justify-between gap-2">
              <h2 class="group-hover:text-accent text-xl font-semibold">
                {project.title}
              </h2>
              <span class="text-muted-foreground flex-shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap">
                {project.status}
              </span>
            </div>
            <p class="text-muted-foreground mt-2">{project.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="bg-muted rounded-full px-2.5 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
