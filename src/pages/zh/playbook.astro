---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PlaybookExample from "@/components/PlaybookExample.astro";
import config from "@/config";

const locale = "zh";

const caseHref = getRelativeLocaleUrl(locale, "projects/prompt-to-ontology");

const handoffChecks = [
  { label: "决策", detail: "谁要决定什么？哪些需求暂时不做？" },
  { label: "证据", detail: "每条映射和建议，审核人能否追到原始依据？" },
  { label: "审核边界", detail: "哪些步骤可以自动流转，哪些必须等人确认？" },
  { label: "验收", detail: "冲突、缺少来源或低置信度时，什么情况算失败？" },
];

// Playbook 方法论页面均已有中文版，链接指向 zh 路由
const categories = [
  {
    title: "AI 原生产品交付",
    items: [
      {
        label: "Vibe Coding for Product Discovery",
        href: getRelativeLocaleUrl("zh", "playbook/vibe-coding"),
        status: "live",
      },
      {
        label: "Harness Engineering",
        href: getRelativeLocaleUrl("zh", "playbook/harness-engineering"),
        status: "live",
        zh: true,
      },
      {
        label: "Loop Engineering",
        href: getRelativeLocaleUrl("zh", "playbook/loop-engineering"),
        status: "live",
      },
      {
        label: "AI-Native PRD",
        href: getRelativeLocaleUrl("zh", "playbook/ai-native-prd"),
        status: "live",
      },
      {
        label: "PRD 到原型工作流",
        href: getRelativeLocaleUrl("zh", "playbook/prd-to-prototype"),
        status: "live",
      },
    ],
  },
  {
    title: "智能体产品设计",
    items: [
      {
        label: "Agent 产品设计框架",
        href: getRelativeLocaleUrl("zh", "playbook/agent-product-design"),
        status: "live",
      },
    ],
  },
  {
    title: "本体与知识系统",
    items: [
      {
        label: "Prompt-to-Ontology",
        href: getRelativeLocaleUrl("zh", "playbook/prompt-to-ontology"),
        status: "live",
      },
    ],
  },
  {
    title: "搜索与增长",
    items: [
      {
        label: "SEO to GEO",
        href: getRelativeLocaleUrl("zh", "playbook/seo-to-geo"),
        status: "live",
      },
    ],
  },
];
---

<Layout
  title={`方法论 — ${config.site.title}`}
  description="Prompt-to-Ontology 与 Agent Anatomy 背后的产品方法：从具体问题出发，明确证据、审核边界和可验证的验收条件。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="项目背后的方法" class="app-prose">
    <p>
      公开项目展示系统本身；这里记录构建时用到的判断。下面以已公开的
      Prompt-to-Ontology 原型为例，复盘一个产品问题如何被拆成可讨论的交付物。
    </p>

    <div class="mt-8">
      <PlaybookExample locale="zh" caseHref={caseHref} />
    </div>

    <section class="mt-10" aria-labelledby="handoff-title">
      <h2 id="handoff-title" class="text-xl font-semibold">交付前检查</h2>
      <p class="text-muted-foreground mt-2 text-sm">
        简报有价值，不是因为格式完整，而是因为接手的人能质疑其中的假设。我会用这些问题检查本体映射和
        Agent 动作设计。
      </p>
      <div
        class="border-border bg-border mt-5 grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2"
      >
        {
          handoffChecks.map(check => (
            <div class="bg-background p-5">
              <h3 class="font-medium">{check.label}</h3>
              <p class="text-muted-foreground mt-2 text-sm">{check.detail}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">四步方法</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        这套方法与我的工作有关；想先了解背景，可以读 <a
          href="/zh/one-page/"
          class="text-accent hover:underline">中文一页介绍</a
        >。
      </p>
      <ol class="mt-4 space-y-3">
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >01</span
          >
          <span>
            <span class="font-medium">框定模糊问题</span><span
              class="text-muted-foreground"
            >
              ——把一个模糊的问题转化为结构化的概念：业务真正赖以运转的实体、关系与约束。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >02</span
          >
          <span>
            <span class="font-medium">设计系统</span><span
              class="text-muted-foreground"
            >
              ——决定模型做什么、Agent
              被允许做什么，以及人在哪个环节留在回路里。架构本身就是一个产品决策。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >03</span
          >
          <span>
            <span class="font-medium">用 AI 构建</span><span
              class="text-muted-foreground"
            >
              ——用编码智能体 vibe-code
              出可运行的原型。真正重要的是那套「harness」——上下文、工具、约束、反馈——而不是敲了多少键。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >04</span
          >
          <span>
            <span class="font-medium">提炼范式</span><span
              class="text-muted-foreground"
            >
              ——把每一次构建沉淀为可复用的方法论，让下一个问题的起点比上一个更靠前。</span
            >
          </span>
        </li>
      </ol>
    </div>

    <div class="mt-10 space-y-8">
      {
        categories.map(category => (
          <section>
            <h2 class="text-xl font-semibold">{category.title}</h2>
            <ul class="mt-3 space-y-2">
              {category.items.map(item => (
                <li class="text-muted-foreground flex items-start gap-2">
                  <span class="text-accent mt-1">&#x2022;</span>
                  {item.href ? (
                    <a href={item.href} class="text-accent hover:underline">
                      {item.label}
                    </a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-10 text-sm">
      这些是工作方法，不是另一个产品。你可以在
      <a href={caseHref} class="text-accent hover:underline"
        >Prompt-to-Ontology</a
      >
      中看到它们如何落到原型，也可以在
      <a
        href="https://wenhaoyu-bryan.github.io/agent-anatomy/"
        class="text-accent hover:underline">Agent Anatomy ↗</a
      >
      里探索智能体运行过程。
    </p>
  </Main>

  <Footer />
</Layout>
