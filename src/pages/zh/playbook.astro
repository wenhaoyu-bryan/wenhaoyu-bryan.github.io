---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PlaybookExample from "@/components/PlaybookExample.astro";
import config from "@/config";

const locale = "zh";

const WORKBENCH_URL =
  "https://wenhaoyu-bryan.github.io/AI-PM-Operating-Playbook/zh-CN/workbench/";
const caseHref = getRelativeLocaleUrl(locale, "projects/prompt-to-ontology");

// Playbook 方法论页面均已有中文版，链接指向 zh 路由
const categories = [
  {
    title: "AI 原生产品交付",
    items: [
      {
        label: "Vibe Coding for Product Discovery",
        href: getRelativeLocaleUrl("zh", "playbook/vibe-coding"),
        status: "live",
      },
      {
        label: "Harness Engineering",
        href: getRelativeLocaleUrl("zh", "playbook/harness-engineering"),
        status: "live",
        zh: true,
      },
      {
        label: "Loop Engineering",
        href: getRelativeLocaleUrl("zh", "playbook/loop-engineering"),
        status: "live",
      },
      {
        label: "AI-Native PRD",
        href: getRelativeLocaleUrl("zh", "playbook/ai-native-prd"),
        status: "live",
      },
      {
        label: "PRD 到原型工作流",
        href: getRelativeLocaleUrl("zh", "playbook/prd-to-prototype"),
        status: "live",
      },
    ],
  },
  {
    title: "智能体产品设计",
    items: [
      {
        label: "Agent 产品设计框架",
        href: getRelativeLocaleUrl("zh", "playbook/agent-product-design"),
        status: "live",
      },
    ],
  },
  {
    title: "本体与知识系统",
    items: [
      {
        label: "Prompt-to-Ontology",
        href: getRelativeLocaleUrl("zh", "playbook/prompt-to-ontology"),
        status: "live",
      },
    ],
  },
  {
    title: "搜索与增长",
    items: [
      {
        label: "SEO to GEO",
        href: getRelativeLocaleUrl("zh", "playbook/seo-to-geo"),
        status: "live",
      },
    ],
  },
];
---

<Layout
  title={`产品方法实验 — ${config.site.title}`}
  description="从 Prompt-to-Ontology 的真实产品问题出发，展示可讨论的交付物，以及 AI 产品设计、评估和交付的方法。"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="从产品问题，到可讨论的交付物" class="app-prose">
    <p>
      我把产品方法和实践笔记放在这里。下面以已公开的 Prompt-to-Ontology
      原型为例，复盘一个问题如何被拆成产品简报、工作流和验收检查。
    </p>

    <div class="mt-8">
      <PlaybookExample locale="zh" caseHref={caseHref} />
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={WORKBENCH_URL}
        class="bg-accent text-accent-foreground inline-flex items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
        target="_blank"
        rel="noopener noreferrer"
      >
        可选：打开结构化工作台 ↗
      </a>
      <span class="text-muted-foreground text-sm">
        手动整理输入 · 浏览器本地保存 · 模板化导出 · 暂无模型调用
      </span>
    </div>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">四步方法</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        这套方法与我的工作有关；想先了解背景，可以读 <a
          href="/zh/one-page/"
          class="text-accent hover:underline">中文一页介绍</a
        >。
      </p>
      <ol class="mt-4 space-y-3">
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >01</span
          >
          <span>
            <span class="font-medium">框定模糊问题</span><span
              class="text-muted-foreground"
            >
              ——把一个模糊的问题转化为结构化的概念：业务真正赖以运转的实体、关系与约束。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >02</span
          >
          <span>
            <span class="font-medium">设计系统</span><span
              class="text-muted-foreground"
            >
              ——决定模型做什么、Agent
              被允许做什么，以及人在哪个环节留在回路里。架构本身就是一个产品决策。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >03</span
          >
          <span>
            <span class="font-medium">用 AI 构建</span><span
              class="text-muted-foreground"
            >
              ——用编码智能体 vibe-code
              出可运行的原型。真正重要的是那套「harness」——上下文、工具、约束、反馈——而不是敲了多少键。</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >04</span
          >
          <span>
            <span class="font-medium">提炼范式</span><span
              class="text-muted-foreground"
            >
              ——把每一次构建沉淀为可复用的方法论，让下一个问题的起点比上一个更靠前。</span
            >
          </span>
        </li>
      </ol>
    </div>

    <div class="mt-10 space-y-8">
      {
        categories.map(category => (
          <section>
            <h2 class="text-xl font-semibold">{category.title}</h2>
            <ul class="mt-3 space-y-2">
              {category.items.map(item => (
                <li class="text-muted-foreground flex items-start gap-2">
                  <span class="text-accent mt-1">&#x2022;</span>
                  {item.href ? (
                    <a href={item.href} class="text-accent hover:underline">
                      {item.label}
                    </a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-10 text-sm">
      工作台仍作为单独的实验保留原网址和
      <a
        class="text-accent hover:underline"
        href="https://github.com/wenhaoyu-bryan/AI-PM-Operating-Playbook"
        target="_blank"
        rel="noopener noreferrer">源码仓库 ↗</a
      >； 方法文章留在这个个人网站。
    </p>
  </Main>

  <Footer />
</Layout>
