---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PlaybookExample from "@/components/PlaybookExample.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const caseHref = getRelativeLocaleUrl(locale, "projects/prompt-to-ontology");

const handoffChecks = [
  {
    label: "Decision",
    detail: "Who is making which decision, and what stays out of scope?",
  },
  {
    label: "Evidence",
    detail:
      "Can a reviewer inspect the source behind each mapping or recommendation?",
  },
  {
    label: "Review boundary",
    detail: "What can move automatically, and what must wait for a person?",
  },
  {
    label: "Acceptance",
    detail:
      "Which conflict, missing-source, or low-confidence case would fail the test?",
  },
];

const categories = [
  {
    title: "AI-Native Product Delivery",
    items: [
      {
        label: "Vibe Coding for Product Discovery",
        href: getRelativeLocaleUrl(locale, "playbook/vibe-coding"),
        status: "live",
      },
      {
        label: "Harness Engineering",
        href: getRelativeLocaleUrl(locale, "playbook/harness-engineering"),
        status: "live",
      },
      {
        label: "Loop Engineering",
        href: getRelativeLocaleUrl(locale, "playbook/loop-engineering"),
        status: "live",
      },
      {
        label: "AI-Native PRD",
        href: getRelativeLocaleUrl(locale, "playbook/ai-native-prd"),
        status: "live",
      },
      {
        label: "PRD to Prototype Workflow",
        href: getRelativeLocaleUrl(locale, "playbook/prd-to-prototype"),
        status: "live",
      },
    ],
  },
  {
    title: "Agent Product Design",
    items: [
      {
        label: "Agent Product Design Framework",
        href: getRelativeLocaleUrl(locale, "playbook/agent-product-design"),
        status: "live",
      },
    ],
  },
  {
    title: "Ontology and Knowledge Systems",
    items: [
      {
        label: "Prompt-to-Ontology",
        href: getRelativeLocaleUrl(locale, "playbook/prompt-to-ontology"),
        status: "live",
      },
    ],
  },
  {
    title: "Search and Growth",
    items: [
      {
        label: "SEO to GEO",
        href: getRelativeLocaleUrl(locale, "playbook/seo-to-geo"),
        status: "live",
      },
    ],
  },
];
---

<Layout
  title={`Methodology — ${config.site.title}`}
  description="Product methods behind Prompt-to-Ontology and Agent Anatomy: from a concrete question to evidence, review boundaries, and testable acceptance checks."
  ogImage="/og/playbook.png"
>
  <Header />
  <Breadcrumb />

  <Main pageTitle="Methods behind the work" class="app-prose">
    <p>
      The public projects show the systems; this page keeps the working notes
      behind them. Below, I revisit Prompt-to-Ontology as one concrete product
      question, then spell out what I would check before handing the design to a
      team.
    </p>

    <div class="mt-8">
      <PlaybookExample locale="en" caseHref={caseHref} />
    </div>

    <section class="mt-10" aria-labelledby="handoff-title">
      <h2 id="handoff-title" class="text-xl font-semibold">
        Review the handoff
      </h2>
      <p class="text-muted-foreground mt-2 text-sm">
        A brief is useful only if the next person can question its assumptions.
        I use these checks for ontology mappings and agent actions alike.
      </p>
      <div
        class="border-border bg-border mt-5 grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2"
      >
        {
          handoffChecks.map(check => (
            <div class="bg-background p-5">
              <h3 class="font-medium">{check.label}</h3>
              <p class="text-muted-foreground mt-2 text-sm">{check.detail}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">The four-step method</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        The through-line behind everything here — laid out in the <a
          href="/about/manifesto/"
          class="text-accent hover:underline">How I Build ↗</a
        >.
      </p>
      <ol class="mt-4 space-y-3">
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >01</span
          >
          <span>
            <span class="font-medium">Frame the ambiguity</span><span
              class="text-muted-foreground"
            >
              — Turn a vague problem into a structured concept — the entities,
              relationships, and constraints the business actually runs on.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >02</span
          >
          <span>
            <span class="font-medium">Design the system</span><span
              class="text-muted-foreground"
            >
              — Decide what the model does, what the agent is allowed to do, and
              where the human stays in the loop. Architecture is a product
              decision.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >03</span
          >
          <span>
            <span class="font-medium">Build with AI</span><span
              class="text-muted-foreground"
            >
              — Vibe-code working prototypes with coding agents. The harness —
              context, tools, constraints, feedback — matters more than the
              keystrokes.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >04</span
          >
          <span>
            <span class="font-medium">Extract the pattern</span><span
              class="text-muted-foreground"
            >
              — Turn each build into reusable methodology, so the next problem
              starts further ahead than the last.</span
            >
          </span>
        </li>
      </ol>
    </div>

    <div class="mt-10 space-y-8">
      {
        categories.map(category => (
          <section>
            <h2 class="text-xl font-semibold">{category.title}</h2>
            <ul class="mt-3 space-y-2">
              {category.items.map(item => (
                <li class="text-muted-foreground flex items-start gap-2">
                  <span class="text-accent mt-1">&#x2022;</span>
                  {item.href ? (
                    <a href={item.href} class="text-accent hover:underline">
                      {item.label}
                    </a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-10 text-sm">
      These are working methods, not another product. See them tested in
      <a href={caseHref} class="text-accent hover:underline"
        >Prompt-to-Ontology</a
      >
      and explored visually in
      <a
        href="https://wenhaoyu-bryan.github.io/agent-anatomy/"
        class="text-accent hover:underline">Agent Anatomy ↗</a
      >.
    </p>
  </Main>

  <Footer />
</Layout>
