---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PlaybookExample from "@/components/PlaybookExample.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const WORKBENCH_URL =
  "https://wenhaoyu-bryan.github.io/AI-PM-Operating-Playbook/en/workbench/";
const caseHref = getRelativeLocaleUrl(locale, "projects/prompt-to-ontology");

const categories = [
  {
    title: "AI-Native Product Delivery",
    items: [
      {
        label: "Vibe Coding for Product Discovery",
        href: getRelativeLocaleUrl(locale, "playbook/vibe-coding"),
        status: "live",
      },
      {
        label: "Harness Engineering",
        href: getRelativeLocaleUrl(locale, "playbook/harness-engineering"),
        status: "live",
      },
      {
        label: "Loop Engineering",
        href: getRelativeLocaleUrl(locale, "playbook/loop-engineering"),
        status: "live",
      },
      {
        label: "AI-Native PRD",
        href: getRelativeLocaleUrl(locale, "playbook/ai-native-prd"),
        status: "live",
      },
      {
        label: "PRD to Prototype Workflow",
        href: getRelativeLocaleUrl(locale, "playbook/prd-to-prototype"),
        status: "live",
      },
    ],
  },
  {
    title: "Agent Product Design",
    items: [
      {
        label: "Agent Product Design Framework",
        href: getRelativeLocaleUrl(locale, "playbook/agent-product-design"),
        status: "live",
      },
    ],
  },
  {
    title: "Ontology and Knowledge Systems",
    items: [
      {
        label: "Prompt-to-Ontology",
        href: getRelativeLocaleUrl(locale, "playbook/prompt-to-ontology"),
        status: "live",
      },
    ],
  },
  {
    title: "Search and Growth",
    items: [
      {
        label: "SEO to GEO",
        href: getRelativeLocaleUrl(locale, "playbook/seo-to-geo"),
        status: "live",
      },
    ],
  },
];
---

<Layout
  title={`Product method experiment — ${config.site.title}`}
  description="A real product question from Prompt-to-Ontology, the reviewable outputs it led to, and practical methods for AI product work."
  ogImage="/og/playbook.png"
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="From a product question to a reviewable handoff"
    class="app-prose"
  >
    <p>
      I keep my AI product methods and field notes here. The example below
      revisits my public Prompt-to-Ontology prototype: one product question,
      broken into a brief, workflow, and acceptance checks.
    </p>

    <div class="mt-8">
      <PlaybookExample locale="en" caseHref={caseHref} />
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={WORKBENCH_URL}
        class="bg-accent text-accent-foreground inline-flex items-center gap-1.5 rounded-md px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open the optional workbench ↗
      </a>
      <span class="text-muted-foreground text-sm">
        Manual inputs · local save · template-based exports · no model call
      </span>
    </div>

    <div class="border-border mt-10 rounded-lg border p-6">
      <h2 class="text-lg font-semibold">The four-step method</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        The through-line behind everything here — laid out in the <a
          href="/about/manifesto/"
          class="text-accent hover:underline">How I Build ↗</a
        >.
      </p>
      <ol class="mt-4 space-y-3">
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >01</span
          >
          <span>
            <span class="font-medium">Frame the ambiguity</span><span
              class="text-muted-foreground"
            >
              — Turn a vague problem into a structured concept — the entities,
              relationships, and constraints the business actually runs on.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >02</span
          >
          <span>
            <span class="font-medium">Design the system</span><span
              class="text-muted-foreground"
            >
              — Decide what the model does, what the agent is allowed to do, and
              where the human stays in the loop. Architecture is a product
              decision.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >03</span
          >
          <span>
            <span class="font-medium">Build with AI</span><span
              class="text-muted-foreground"
            >
              — Vibe-code working prototypes with coding agents. The harness —
              context, tools, constraints, feedback — matters more than the
              keystrokes.</span
            >
          </span>
        </li>
        <li class="flex gap-3">
          <span class="text-accent mt-0.5 text-sm font-medium tabular-nums"
            >04</span
          >
          <span>
            <span class="font-medium">Extract the pattern</span><span
              class="text-muted-foreground"
            >
              — Turn each build into reusable methodology, so the next problem
              starts further ahead than the last.</span
            >
          </span>
        </li>
      </ol>
    </div>

    <div class="mt-10 space-y-8">
      {
        categories.map(category => (
          <section>
            <h2 class="text-xl font-semibold">{category.title}</h2>
            <ul class="mt-3 space-y-2">
              {category.items.map(item => (
                <li class="text-muted-foreground flex items-start gap-2">
                  <span class="text-accent mt-1">&#x2022;</span>
                  {item.href ? (
                    <a href={item.href} class="text-accent hover:underline">
                      {item.label}
                    </a>
                  ) : (
                    <span>{item.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-10 text-sm">
      The workbench remains a separate experiment with its own URL and
      <a
        class="text-accent hover:underline"
        href="https://github.com/wenhaoyu-bryan/AI-PM-Operating-Playbook"
        target="_blank"
        rel="noopener noreferrer">source repository ↗</a
      >. The longer explanations stay here on the personal site.
    </p>
  </Main>

  <Footer />
</Layout>
