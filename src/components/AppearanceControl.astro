---
import { Moon, Sun } from "lucide-astro";

interface Props {
  locale: "en" | "zh";
}

const zh = Astro.props.locale === "zh";
---

<button
  id="theme-btn"
  type="button"
  class="focus-outline theme-toggle"
  aria-label={zh ? "切换深浅主题" : "Toggle color theme"}
  data-label-light={zh ? "切换到浅色" : "Switch to light mode"}
  data-label-dark={zh ? "切换到深色" : "Switch to dark mode"}
>
  <Moon size={21} class="dark:hidden" aria-hidden="true" />
  <Sun size={22} class="hidden dark:block" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    display: grid;
    min-inline-size: 36px;
    min-block-size: 36px;
    place-items: center;
    border-radius: 6px;
  }
  .theme-toggle:hover {
    color: var(--accent);
    background: var(--muted);
  }
</style>
