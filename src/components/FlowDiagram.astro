---
/**
 * A flat, theme-aware flow diagram: bordered step boxes joined by arrows,
 * wrapping on small screens. Use for architecture / workflow visuals instead
 * of raster images (see DESIGN.md — content visuals in line-art style).
 */
interface Step {
  label: string;
  note?: string;
  emphasis?: boolean;
}

interface Props {
  steps: Step[];
  caption?: string;
  compact?: boolean;
}

const { steps, caption, compact = false } = Astro.props;
---

<figure
  class:list={[
    "border-border rounded-lg border",
    compact ? "bg-background mt-3 p-3" : "mt-4 p-4 sm:p-5",
  ]}
>
  <div
    class:list={[
      "flex items-stretch gap-2",
      compact ? "flex-col sm:flex-row" : "flex-wrap",
    ]}
  >
    {
      steps.map((step, i) => (
        <>
          <div
            class:list={[
              "border-border flex flex-1 flex-col justify-center rounded-md border px-3 py-2 text-center",
              compact ? "min-w-0" : "min-w-28 basis-32",
              step.emphasis ? "bg-muted/40" : "bg-background",
            ]}
          >
            <span class="text-foreground text-sm font-semibold">
              {step.label}
            </span>
            {step.note && (
              <span class="text-muted-foreground mt-1 text-xs">
                {step.note}
              </span>
            )}
          </div>
          {i < steps.length - 1 && (
            <div
              class="text-muted-foreground flex items-center justify-center text-sm"
              aria-hidden="true"
            >
              <span class:list={[compact && "rotate-90 sm:rotate-0"]}>
                &rarr;
              </span>
            </div>
          )}
        </>
      ))
    }
  </div>
  {
    caption && (
      <figcaption
        class:list={[
          "text-muted-foreground mt-3 text-xs",
          compact && "opacity-100",
        ]}
      >
        {caption}
      </figcaption>
    )
  }
</figure>
