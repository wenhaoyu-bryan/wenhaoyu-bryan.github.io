---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  locale: string;
};

const { headings, locale } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
const label = locale === "zh" ? "本文目录" : "On this page";
---

{
  sections.length >= 2 && (
    <nav aria-label={label} class="article-contents">
      <p class="article-contents__label">{label}</p>
      <ol>
        {sections.map(heading => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .article-contents {
    margin-block-start: 1.75rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow-wrap: anywhere;
  }

  .article-contents__label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .article-contents ol {
    display: grid;
    gap: 0.35rem;
    margin-block: 0.7rem 0;
    padding-inline-start: 1.2rem;
  }

  .article-contents a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .article-contents a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
