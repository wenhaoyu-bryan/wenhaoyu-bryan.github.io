---
import type { ComponentProps } from "astro/types";
import FlowDiagram from "@/components/FlowDiagram.astro";

interface Props {
  facts: { label: string; value: string }[];
  decision: string;
  steps?: ComponentProps<typeof FlowDiagram>["steps"];
  caption?: string;
}

const { facts, decision, steps, caption } = Astro.props;
---

<section class="not-prose case-lead" aria-labelledby="case-decision">
  <dl class="case-facts">
    {
      facts.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
  <slot name="navigation" />
  <h2 id="case-decision">{decision}</h2>
  <slot>
    {steps && <FlowDiagram {steps} {caption} compact />}
  </slot>
</section>

<style>
  .case-lead {
    margin-block: 20px 24px;
    padding: clamp(16px, 3vw, 26px);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--home-surface);
  }
  .case-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 10px 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .case-facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted-foreground);
  }
  .case-facts dd {
    margin-top: 2px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .case-lead h2 {
    margin: 15px 0 0;
    font-size: clamp(1.125rem, 2.4vw, 1.45rem);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.023em;
    text-wrap: pretty;
  }
</style>
