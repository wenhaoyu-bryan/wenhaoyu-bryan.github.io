---
import { getRelativeLocaleUrl } from "astro:i18n";
import { execFileSync } from "node:child_process";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  pagefind?: boolean;
  class?: string;
};

const { pageTitle, pageDesc, pagefind = true, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const isPlaybookArticle = /^\/(?:zh\/)?playbook\/[^/]+\/?$/.test(
  Astro.url.pathname
);
// A build timestamp is not a content update. Only show a date when complete,
// clean Git history is available for the specific page source.
let lastUpdated: Date | undefined;
if (isPlaybookArticle) {
  const source = `src/pages${Astro.url.pathname.replace(/\/$/, "")}.astro`;
  const git = (...args: string[]) =>
    execFileSync("git", args, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  try {
    if (
      git("rev-parse", "--is-shallow-repository") === "false" &&
      !git("status", "--porcelain", "--", source)
    ) {
      const date = git("log", "-1", "--format=%cI", "--", source);
      if (date && !Number.isNaN(Date.parse(date))) lastUpdated = new Date(date);
    }
  } catch {
    // Source archives and local previews may not have usable Git metadata.
  }
}
const lastUpdatedLabel = lastUpdated
  ? new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-GB", {
      dateStyle: "medium",
      timeZone: config.site.timezone,
    }).format(lastUpdated)
  : undefined;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  data-pagefind-body={pagefind ? true : undefined}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1 class="text-2xl font-semibold sm:text-3xl">{pageTitle}</h1>
  {
    isPlaybookArticle && (
      <p class="text-muted-foreground mt-2 text-sm">
        {locale === "zh" ? "作者：" : "By "}
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="text-accent hover:underline"
        >
          {config.site.author}
        </a>
        {lastUpdated && (
          <>
            <span aria-hidden="true"> · </span>
            {locale === "zh" ? "更新于 " : "Updated "}
            <time datetime={lastUpdated.toISOString()}>{lastUpdatedLabel}</time>
          </>
        )}
      </p>
    )
  }
  {pageDesc && <p class="mt-2 mb-6 italic">{pageDesc}</p>}
  {
    isPlaybookArticle && (
      <div data-playbook-reading hidden>
        <p
          data-playbook-reading-time
          class="text-muted-foreground mt-2 text-sm"
        />
        <nav
          data-playbook-contents
          aria-label={locale === "zh" ? "本文目录" : "On this page"}
          class="border-border mt-6 rounded-xl border px-5 py-4"
        >
          <details>
            <summary class="cursor-pointer py-1 text-sm font-semibold">
              {locale === "zh" ? "本文目录" : "On this page"}
            </summary>
            <ol
              data-playbook-contents-list
              class="mt-3 grid list-decimal gap-1 ps-5"
            />
          </details>
        </nav>
      </div>
    )
  }
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }

    const reading = mainContent?.querySelector<HTMLElement>(
      "[data-playbook-reading]"
    );
    const list = reading?.querySelector<HTMLOListElement>(
      "[data-playbook-contents-list]"
    );
    const nav = reading?.querySelector<HTMLElement>("[data-playbook-contents]");
    const time = reading?.querySelector<HTMLElement>(
      "[data-playbook-reading-time]"
    );
    if (
      !mainContent ||
      !reading ||
      !list ||
      !nav ||
      !time ||
      reading.dataset.ready
    )
      return;

    const zh = document.documentElement.lang.toLowerCase().startsWith("zh");
    const content = mainContent.textContent ?? "";
    const hanCount = (content.match(/\p{Script=Han}/gu) ?? []).length;
    const wordCount = (
      content.replace(/\p{Script=Han}/gu, " ").match(/[\p{L}\p{N}]+/gu) ?? []
    ).length;
    const minutes = Math.max(1, Math.ceil(hanCount / 400 + wordCount / 220));
    time.textContent = zh ? `约 ${minutes} 分钟阅读` : `${minutes} min read`;

    const sections = Array.from(
      mainContent.querySelectorAll<HTMLHeadingElement>("h2")
    );
    const usedIds = new Set(
      Array.from(document.querySelectorAll("[id]"), el => el.id)
    );
    for (const section of sections) {
      if (!section.id) {
        const base =
          (section.textContent ?? "")
            .normalize("NFKC")
            .toLowerCase()
            .replace(/[^\p{L}\p{N}]+/gu, "-")
            .replace(/^-|-$/g, "") || "section";
        let id = base;
        let suffix = 2;
        while (usedIds.has(id)) id = `${base}-${suffix++}`;
        section.id = id;
        usedIds.add(id);
      }
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = `#${encodeURIComponent(section.id)}`;
      link.textContent = section.textContent?.trim() ?? "";
      link.className =
        "text-accent inline-block rounded-sm py-1 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2";
      item.appendChild(link);
      list.appendChild(item);
    }
    nav.hidden = sections.length < 2;
    reading.dataset.ready = "true";
    reading.hidden = false;

    // Initial fragment navigation happens before generated ids exist.
    if (location.hash) {
      try {
        const target = document.getElementById(
          decodeURIComponent(location.hash.slice(1))
        );
        if (target && sections.includes(target as HTMLHeadingElement))
          target.scrollIntoView();
      } catch {
        // An invalid encoded fragment is not a section link.
      }
    }
  });
</script>
