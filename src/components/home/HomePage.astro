---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ArrowRight, ArrowUpRight, Plus } from "lucide-astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactRow from "@/components/ContactRow.astro";
import AskAI from "@/components/AskAI.astro";
import SystemsAtelier from "./SystemsAtelier.astro";
import ProjectShowcase from "./ProjectShowcase.astro";
import { getWork, getBuilds, getListedBuilds } from "@/data/projects";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { isMirroredRoute } from "@/i18n/routes";
import "@/styles/home.css";
interface Props {
  locale: "en" | "zh";
}
const { locale } = Astro.props;
const zh = locale === "zh";
const url = (path: string) => getRelativeLocaleUrl(locale, path);
const builds = getListedBuilds(locale);
const ontology = builds.find(
  project => project.title === "Prompt-to-Ontology"
)!;
const anatomy = builds.find(project => project.title === "Agent Anatomy")!;
const growth = getBuilds(locale).find(
  project => project.title === "SEO/GEO Growth Experiments"
)!;
const work = getWork(locale).flatMap(project =>
  project.ledger?.featured
    ? [
        {
          href: project.href,
          ...project.ledger.featured,
        },
      ]
    : []
);
const posts = getSortedPosts(await getCollection("posts"))
  .filter(({ data }) => !data.featured)
  .slice(0, 3);
const translations = zh ? await getCollection("pages") : [];
const postCards = posts.map(post => {
  const englishUrl = getPostUrl(post.id, post.filePath, "en");
  const translation =
    zh && isMirroredRoute(englishUrl)
      ? translations.find(page => page.id === `${post.id}-zh`)
      : undefined;

  return {
    post,
    title: translation?.data.title ?? post.data.title,
    href: translation ? getPostUrl(post.id, post.filePath, "zh") : englishUrl,
    lang: translation ? "zh" : "en",
  };
});
const copy = zh
  ? {
      name: "余文豪",
      role: "AI 产品经理",
      focus: "本体系统与企业智能体",
      intro:
        "我在 TCL 主导企业级智能体平台的产品设计，也参与本体平台的研发，让用户能查看 AI 回答所依据的证据。",
      explore: "查看工作案例",
      contact: "联系我",
      workTitle: "在 TCL 的工作",
      workLink: "全部工作经历",
      projectsTitle: "公开项目",
      allProjects: "所有项目",
      growthTitle: "产品增长实验",
      growthDescription:
        "记录我在 SEO 与 AI 搜索发现上的实践，包括问题、验证过程和后续观察。",
      growthLink: "查看 Growth Lab",
      thinkingTitle: "构建之外，也记录思考。",
      writingLink: "全部文章",
      english: "英文文章",
      writingIntro: "关于 AI 产品、系统设计，以及与编码智能体一起工作的实践。",
      contactTitle: "聊聊你正在思考的 AI 产品。",
      contactDescription:
        "欢迎交流产品、团队与真实业务问题，也欢迎联系我讨论合作机会。",
      ai: "也可以用 AI 了解我的经历",
      now: "我现在在做什么",
    }
  : {
      name: "Wenhao Yu",
      role: "AI Product Manager",
      focus: "Ontology systems & enterprise agents",
      intro:
        "At TCL, I lead product design for an enterprise agent platform and prototype ways to trace AI answers back to their evidence.",
      explore: "View case studies",
      contact: "Contact",
      workTitle: "Work at TCL",
      workLink: "All work",
      projectsTitle: "Public projects",
      allProjects: "All projects",
      growthTitle: "Growth experiments",
      growthDescription:
        "Notes on SEO and how AI search is changing product discovery, with the questions, tests, and follow-up behind each experiment.",
      growthLink: "Read the Growth Lab",
      thinkingTitle: "Thinking through the work.",
      writingLink: "All writing",
      english: "Essay",
      writingIntro:
        "Notes on AI products, system design, and working with coding agents.",
      contactTitle: "Let’s talk AI products.",
      contactDescription:
        "I’m open to product roles and collaborations. Get in touch to talk about a team, a product, or a real problem worth solving.",
      ai: "Ask an AI about my work",
      now: "What I’m doing now",
    };
---

<Layout
  portfolio
  title={zh
    ? "余文豪（Bryan）| AI 产品经理与构建者"
    : "Wenhao Yu (Bryan) | AI Product Manager & Builder"}
  description={zh
    ? "余文豪（Bryan）是一名 AI 产品经理，探索企业智能体平台、可验证的本体原型，以及 AI 产品与协作实践。"
    : "AI product manager designing enterprise agent platforms and building operational ontology prototypes. Explore projects, case studies, and practical notes."}
  ogImage="/og/home.png"
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={url("")}
    data-pagefind-body
    class="portfolio-main"
    lang={locale}
  >
    <div class="portfolio-hero">
      <section class="hero-copy" aria-labelledby="home-role">
        <div class="hero-identity">
          <img src="/profile-avatar.jpg" alt="" width="44" height="44" />
          <span>{copy.name} <span class="hero-byline">/ Bryan</span></span>
        </div>
        <h1 id="home-role" class="hero-statement">{copy.role}</h1>
        <p class="hero-focus">{copy.focus}</p>
        <p class="hero-intro">{copy.intro}</p>
        <div class="hero-actions">
          <a href="#selected-work" class="portfolio-button">
            {copy.explore}<ArrowRight size={18} aria-hidden="true" />
          </a>
          <a href="#contact" class="portfolio-text-link">
            {copy.contact}<ArrowUpRight size={17} aria-hidden="true" />
          </a>
        </div>
      </section>

      <section
        id="selected-work"
        class="home-work"
        aria-labelledby="selected-work-heading"
      >
        <div class="portfolio-section-header">
          <h2 id="selected-work-heading">{copy.workTitle}</h2>
          <a href={url("work")} class="portfolio-text-link">
            {copy.workLink}<ArrowRight size={17} aria-hidden="true" />
          </a>
        </div>
        <div class="home-work-grid">
          {
            work.map(item => (
              <article>
                <a class="home-work-card" href={item.href}>
                  <span class="home-work-meta">{item.stage}</span>
                  <h3>{item.title}</h3>
                  <p>{item.contribution}</p>
                  <ArrowUpRight
                    class="home-work-arrow"
                    size={19}
                    aria-hidden="true"
                  />
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <div class="hero-diagram">
        <SystemsAtelier locale={locale} />
      </div>
    </div>

    <section
      class="portfolio-section"
      aria-labelledby="public-projects-heading"
    >
      <div class="portfolio-section-header">
        <h2 id="public-projects-heading">{copy.projectsTitle}</h2>
        <a href={url("projects")} class="portfolio-text-link">
          {copy.allProjects}<ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
      <ProjectShowcase projects={[ontology, anatomy]} {locale} heading="h3" />
      <div class="growth-note">
        <div>
          <h3>{copy.growthTitle}</h3>
          <p>{copy.growthDescription}</p>
        </div><a href={growth.href} class="portfolio-text-link"
          >{copy.growthLink}<ArrowUpRight size={17} aria-hidden="true" /></a
        >
      </div>
    </section>
    <section
      class="portfolio-section writing-section"
      aria-labelledby="writing-heading"
    >
      <div class="writing-intro">
        <h2 id="writing-heading">{copy.thinkingTitle}</h2><p>
          {copy.writingIntro}
        </p><a href={url("posts")} class="portfolio-text-link"
          >{copy.writingLink}<ArrowRight size={17} aria-hidden="true" /></a
        >
      </div>
      <div class="writing-list">
        {
          postCards.map(({ post, title, href, lang }) => (
            <a {href} class="writing-item">
              <>
                <div class="writing-meta">
                  <>
                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {new Intl.DateTimeFormat(zh ? "zh-CN" : "en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      }).format(post.data.pubDatetime)}
                    </time>
                    <span>{lang === "zh" ? "文章" : copy.english}</span>
                  </>
                </div>
                <div class="writing-title-row">
                  <>
                    <h3 {lang}>{title}</h3>
                    <ArrowUpRight size={21} aria-hidden="true" />
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </section>
    <section
      id="contact"
      class="portfolio-contact"
      aria-labelledby="contact-heading"
    >
      <div>
        <h2 id="contact-heading">{copy.contactTitle}</h2><p>
          {copy.contactDescription}
        </p><ContactRow locale={locale} />
      </div><div class="contact-aside">
        <a href={url("now")} class="portfolio-text-link"
          >{copy.now}<ArrowUpRight size={17} aria-hidden="true" /></a
        ><details class="contact-ai">
          <summary>{copy.ai}<Plus size={17} aria-hidden="true" /></summary
          ><AskAI locale={locale} />
        </details>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  document.addEventListener("astro:page-load", () => {
    const home = document.querySelector<HTMLElement>(".portfolio-main");
    if (home?.dataset.homePath)
      sessionStorage.setItem("backUrl", home.dataset.homePath);
  });
</script>
